#include <stdio.h>
#define MAX 10
int parent[MAX];
int find(int i){
    while(parent[i]) i=parent[i];
    return i;
}
void uni(int i,int j){
    parent[j]=i;
}
int main(){
    int n=4,i,j,a,b,u,v,min,cost=0,edges=0;
    int g[4][4]={{0,2,0,6},{2,0,3,8},{0,3,0,0},{6,8,0,0}};
    while(edges<n-1){
        min=999;
        for(i=0;i<n;i++){
            for(j=0;j<n;j++){
                if(g[i][j] && g[i][j]<min){
                    min=g[i][j];
                    a=u=i; b=v=j;
                }
            }
        }
        u=find(u);
        v=find(v);
        if(u!=v){
            uni(u,v);
            cost+=min;
            edges++;
        }
        g[a][b]=g[b][a]=999;
    }
    printf("Cost=%d",cost);
}
