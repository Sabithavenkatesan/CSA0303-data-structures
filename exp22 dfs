#include <stdio.h>
int g[10][10],vis[10],n;
void dfs(int v){
    int i;
    printf("%d ",v);
    vis[v]=1;
    for(i=0;i<n;i++)
        if(g[v][i] && !vis[i])
            dfs(i);
}
int main(){
    int i,j;
    scanf("%d",&n);
    for(i=0;i<n;i++)
        for(j=0;j<n;j++)
            scanf("%d",&g[i][j]);

    dfs(0);
}
