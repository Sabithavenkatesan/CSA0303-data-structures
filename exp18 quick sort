#include <stdio.h>
int part(int a[],int l,int h){
    int p=a[l],i=l+1,j=h,t;
    while(i<=j){
        while(a[i]<=p) i++;
        while(a[j]>p) j--;
        if(i<j){ t=a[i];a[i]=a[j];a[j]=t; }
    }
    a[l]=a[j]; a[j]=p;
    return j;
}
void qs(int a[],int l,int h){
    if(l<h){
        int j=part(a,l,h);
        qs(a,l,j-1); qs(a,j+1,h);
    }
}
int main(){
    int a[5]={5,2,4,1,3},i;
    qs(a,0,4);
    for(i=0;i<5;i++) printf("%d ",a[i]);
}
