#include <stdio.h>
int q[10],f=0,r=-1,vis[10],g[10][10],n;
void bfs(int v){
    int i;
    printf("%d ",v);
    vis[v]=1;
    for(i=0;i<n;i++){
        if(g[v][i] && !vis[i]){
            q[++r]=i;
            vis[i]=1;
        }
    }
    if(f<=r) bfs(q[f++]);
}
int main(){
    int i,j;
    scanf("%d",&n);
    for(i=0;i<n;i++)
        for(j=0;j<n;j++)
            scanf("%d",&g[i][j]);

    bfs(0);
}
