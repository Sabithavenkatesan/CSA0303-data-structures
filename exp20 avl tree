#include <stdio.h>
#include <stdlib.h>
struct node{
    int key,h;
    struct node *l,*r;
};
int max(int a,int b){ return a>b?a:b; }
int h(struct node* n){ return n?n->h:0; }
struct node* new(int k){
    struct node* n=malloc(sizeof(struct node));
    n->key=k; n->l=n->r=NULL; n->h=1;
    return n;
}
struct node* rr(struct node* y){
    struct node* x=y->l;
    y->l=x->r; x->r=y;
    y->h=max(h(y->l),h(y->r))+1;
    x->h=max(h(x->l),h(x->r))+1;
    return x;
}
struct node* lr(struct node* x){
    struct node* y=x->r;
    x->r=y->l; y->l=x;
    x->h=max(h(x->l),h(x->r))+1;
    y->h=max(h(y->l),h(y->r))+1;
    return y;
}
int bal(struct node* n){ return n?h(n->l)-h(n->r):0; }
struct node* ins(struct node* n,int k){
    if(!n) return new(k);
    if(k<n->key) n->l=ins(n->l,k);
    else if(k>n->key) n->r=ins(n->r,k);
    n->h=1+max(h(n->l),h(n->r));
    int b=bal(n);
    if(b>1 && k<n->l->key) return rr(n);
    if(b<-1 && k>n->r->key) return lr(n);
    if(b>1 && k>n->l->key){ n->l=lr(n->l); return rr(n); }
    if(b<-1 && k<n->r->key){ n->r=rr(n->r); return lr(n); }
    return n;
}
int search(struct node* r,int k){
    if(!r) return 0;
    if(r->key==k) return 1;
    if(k<r->key) return search(r->l,k);
    return search(r->r,k);
}
void inorder(struct node* r){
    if(r){ inorder(r->l); printf("%d ",r->key); inorder(r->r); }
}
int main(){
    struct node* root=NULL;
    root=ins(root,30);
    root=ins(root,20);
    root=ins(root,40);
    root=ins(root,10);
    inorder(root);
    if(search(root,20)) printf("\nFound");
    else printf("\nNot Found");
}
