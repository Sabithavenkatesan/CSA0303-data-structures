#include <stdio.h>
#define INF 999
int main(){
    int n=4,i,j,u,min;
    int g[4][4]={{0,1,4,0},{1,0,4,2},{4,4,0,3},{0,2,3,0}};
    int dist[4]={0,INF,INF,INF},vis[4]={0};
    for(i=0;i<n;i++){
        min=INF;
        for(j=0;j<n;j++)
            if(!vis[j] && dist[j]<min){min=dist[j]; u=j;}
        vis[u]=1;
        for(j=0;j<n;j++)
            if(g[u][j] && dist[u]+g[u][j]<dist[j])
                dist[j]=dist[u]+g[u][j];
    }
    for(i=0;i<n;i++) printf("%d ",dist[i]);
}
