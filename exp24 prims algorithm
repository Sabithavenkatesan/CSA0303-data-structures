#include <stdio.h>
#define INF 999
int main(){
    int n=4,i,j,min,u,v;
    int g[4][4]={{0,2,0,6},{2,0,3,8},{0,3,0,0},{6,8,0,0}};
    int vis[4]={0},cost=0;
    vis[0]=1;
    for(int k=0;k<n-1;k++){
        min=INF;
        for(i=0;i<n;i++){
            if(vis[i]){
                for(j=0;j<n;j++){
                    if(!vis[j] && g[i][j] && g[i][j]<min){
                        min=g[i][j]; u=i; v=j;
                    }
                }
            }
        }
        vis[v]=1;
        cost+=min;
    }
    printf("Cost=%d",cost);
}
